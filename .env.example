# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App address: the one variable for the app's own URL (links, QR tags, emails).
# Production: https://app.flaymforward.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Old addresses printed on QR tags (comma-separated hosts, e.g. flaym-abc.vercel.app).
# They redirect permanently to the same path on NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_LEGACY_HOSTS=

# Email (Resend)
RESEND_API_KEY=re_your_api_key

# Local override only: a host your phone can reach (e.g. http://my-mac.local:3000)
# for scanning dev tags. Used when NEXT_PUBLIC_APP_URL is localhost. Leave unset in production.
NEXT_PUBLIC_QR_BASE_URL=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@cirkle.dk

# Sender for Resend emails
EMAIL_FROM=Flaym <noreply@cirkle.dk>
